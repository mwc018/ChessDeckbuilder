; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Chess Deckbuilder"
run/main_scene="res://scenes/Map.tscn"
config/features=PackedStringArray("4.6")

[autoload]

CardCatalog="*res://scripts/CardCatalog.gd"
RunState="*res://scripts/RunState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=1100
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Chess Deckbuilder"

[rendering]

renderer/rendering_method="mobile"
